# Public variables exposed to the browser (prefixed with NEXT_PUBLIC_)
# Local API: http://localhost:8000/api
# Production API (e.g. Render / Railway / Cloud Run): https://api.fintrack.yourdomain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=FinTrack
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Google OAuth 2.0 Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
