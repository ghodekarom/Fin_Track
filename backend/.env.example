# App Environment
APP_ENV=development
APP_NAME="FinTrack API"
API_PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Database (Async PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000

# JWT & Authentication Security
JWT_SECRET=generate_a_secure_64_character_random_hex_or_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Google OAuth 2.0 / OpenID Connect (Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP / Email Configuration (Optional in development, logs reset link if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-app-password
EMAILS_FROM_EMAIL=noreply@fintrack.app
EMAILS_FROM_NAME="FinTrack App"

# Rate Limiting
LOGIN_RATE_LIMIT="5/minute"
AUTH_RATE_LIMIT="10/minute"
PASSWORD_RESET_RATE_LIMIT="3/minute"

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
