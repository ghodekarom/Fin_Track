# App Environment (development | production)
APP_ENV=development
APP_NAME="FinTrack API"
API_PORT=8000
LOG_LEVEL=INFO

# Frontend Application URL (Used for password reset links and email redirects)
# Local: http://localhost:3000
# Production: https://your-fintrack-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Database (Async PostgreSQL connection string)
# Local: postgresql+asyncpg://postgres:password@localhost:5432/fintrack_db
# Supabase/Prod: postgresql+asyncpg://postgres.[USER]:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fintrack_db

# CORS Allowed Origins (Comma-separated for local and production Vercel deployment)
CORS_ORIGINS=http://localhost:3000,https://your-fintrack-app.vercel.app

# JWT & Authentication Security
JWT_SECRET=generate_a_secure_64_character_random_hex_or_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Google OAuth 2.0 / OpenID Connect (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP / Email Configuration (Optional in development; logs reset link to console if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAILS_FROM_EMAIL=noreply@fintrack.app
EMAILS_FROM_NAME="FinTrack App"

# Rate Limiting
LOGIN_RATE_LIMIT="10/minute"
AUTH_RATE_LIMIT="20/minute"
PASSWORD_RESET_RATE_LIMIT="5/minute"

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
